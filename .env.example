# StockSense Backend Server Port
PORT=5000

# Email SMTP Configuration
# For Gmail: Set SMTP_SERVICE=gmail and use a 16-character Google App Password (generate at https://myaccount.google.com/apppasswords)
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="StockSense Support" <your-email@gmail.com>

# Custom SMTP (optional if not using Gmail):
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
